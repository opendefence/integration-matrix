{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain"],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,53}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "rtc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tcp": { "type": "integer" },
        "udp": { "type": "integer" }
      }
    }
  }
}
